# /etc/wp-mcp/secrets.env — chmod 600, chown wpmcp:wpmcp
# Akun WordPress khusus berperan "Editor AI" (dibuat plugin wp-mcp-bridge), BUKAN Administrator.
WPMCP_WP_USER=editor-ai
WPMCP_WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# MySQL baca-saja (opsional, untuk audit konten): GRANT SELECT ON wordpress.* TO 'wpmcp_ro'@'localhost'
WPMCP_DB_HOST=localhost
WPMCP_DB_NAME=wordpress
WPMCP_DB_USER=wpmcp_ro
WPMCP_DB_PASSWORD=
WPMCP_DB_PREFIX=wp_

# Bot Telegram untuk notifikasi antrean dan kode OTP (opsional)
WPMCP_TELEGRAM_TOKEN=
